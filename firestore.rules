rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function creatorSignedIn() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function ownsForm(formId) {
      return signedIn()
        && get(/databases/$(database)/documents/forms/$(formId)).data.ownerUid == request.auth.uid;
    }

    function canManageForm(formId) {
      let form = get(/databases/$(database)/documents/forms/$(formId)).data;
      return signedIn() && (
        form.ownerUid == request.auth.uid
        || (
          'collaborators' in form
          && form.collaborators[request.auth.uid] in ['viewer', 'editor']
        )
      );
    }

    function canEditForm(formId) {
      let form = get(/databases/$(database)/documents/forms/$(formId)).data;
      return signedIn() && (
        form.ownerUid == request.auth.uid
        || (
          'collaborators' in form
          && form.collaborators[request.auth.uid] == 'editor'
        )
      );
    }

    function participantAllowed(form) {
      let email = 'email' in request.auth.token ? request.auth.token.email : '';
      return !('settings' in form)
        ? request.auth.token.firebase.sign_in_provider != 'anonymous'
        : form.settings.access.participation == 'anyone'
          || (form.settings.access.participation == 'authenticated' && request.auth.token.firebase.sign_in_provider != 'anonymous')
          || (form.settings.access.participation == 'kangnam' && request.auth.token.email_verified == true && email.matches('.*@kangnam[.]ac[.]kr$'))
          || (form.settings.access.participation == 'allowlist'
            && request.auth.token.email_verified == true
            && (
              email in form.settings.access.allowedEmails
              || (
                'groups' in request.auth.token
                && 'allowedGroups' in form.settings.access
                && request.auth.token.groups.hasAny(form.settings.access.allowedGroups)
              )
            ));
    }

    function validResponseCounterIncrement(formId) {
      let responseId = request.resource.data.latestResponseId;
      let responsePath = /databases/$(database)/documents/forms/$(formId)/responses/$(responseId);
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['responseCount', 'latestResponseId', 'updatedAt'])
        && request.resource.data.responseCount == resource.data.responseCount + 1
        && responseId is string
        && request.resource.data.updatedAt == request.time
        && !exists(responsePath)
        && existsAfter(responsePath)
        && getAfter(responsePath).data.actorUid == request.auth.uid
        && getAfter(responsePath).data.formId == formId;
    }

    match /oauthStates/{stateId} {
      allow read, write: if false;
    }

    match /oauthExchanges/{exchangeId} {
      allow read, write: if false;
    }

    match /programs/{programId} {
      allow create: if creatorSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.year is int
        && request.resource.data.year >= 2000
        && request.resource.data.year <= 2100;
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if creatorSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.year is int
        && request.resource.data.year >= 2000
        && request.resource.data.year <= 2100;
      allow delete: if creatorSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /forms/{formId} {
      allow create: if creatorSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.formId == formId;
      // Keep ownership checks on resource.data so an ownerUid-filtered list query
      // can be proven safe by Firestore. A nested get() cannot authorize a query.
      allow read: if signedIn() && (
        resource.data.published == true
        || resource.data.ownerUid == request.auth.uid
        || (
          'collaborators' in resource.data
          && resource.data.collaborators[request.auth.uid] in ['viewer', 'editor']
        )
      );
      allow update: if (
          canEditForm(formId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (
            ('creatorUid' in resource.data && request.resource.data.creatorUid == resource.data.creatorUid)
            || (!('creatorUid' in resource.data) && request.resource.data.creatorUid == resource.data.ownerUid)
          )
          && (
            ('formId' in resource.data && request.resource.data.formId == resource.data.formId)
            || (!('formId' in resource.data) && request.resource.data.formId == formId)
          )
          && (
            ('responseCount' in resource.data && request.resource.data.responseCount == resource.data.responseCount)
            || (!('responseCount' in resource.data) && request.resource.data.responseCount == 0)
          )
        )
        || validResponseCounterIncrement(formId);
      allow delete: if ownsForm(formId);

      match /responses/{responseId} {
        function form() {
          return get(/databases/$(database)/documents/forms/$(formId)).data;
        }

        function capacityAvailable(currentForm) {
          return !('maxResponses' in currentForm.settings.submission)
            || currentForm.settings.submission.maxResponses <= 0
            || currentForm.responseCount < currentForm.settings.submission.maxResponses;
        }

        function validRespondentIdentity(currentForm) {
          let anonymous = request.auth.token.firebase.sign_in_provider == 'anonymous';
          let identityCollection = currentForm.settings.access.identityCollection;
          return request.resource.data.actorUid == request.auth.uid
            && (
              anonymous
                ? request.resource.data.respondentUid == null
                  && request.resource.data.anonymousId == request.auth.uid
                : request.resource.data.respondentUid == request.auth.uid
                  && request.resource.data.anonymousId == null
            )
            && (
              identityCollection == 'profile'
                ? request.resource.data.respondentName.size() > 0
                  && request.resource.data.studentId.size() > 0
                : identityCollection == 'email_input'
                  ? request.resource.data.respondentEmail.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                  : identityCollection == 'verified_email'
                    ? request.auth.token.email_verified == true
                      && request.resource.data.respondentEmail == request.auth.token.email
                    : true
            );
        }

        function validResponseCreate() {
          let currentForm = form();
          let requiredKeys = [
            'responseId', 'formId', 'actorUid', 'respondentUid', 'anonymousId',
            'respondentEmail', 'respondentName', 'studentId', 'attachments',
            'answers', 'status', 'formVersion', 'submittedAt', 'updatedAt', 'immutable'
          ];
          return signedIn()
            && currentForm.published == true
            && currentForm.settings.schedule.status == 'open'
            && (!('surveyEndAt' in currentForm) || request.time <= currentForm.surveyEndAt)
            && participantAllowed(currentForm)
            && capacityAvailable(currentForm)
            && request.resource.data.keys().hasAll(requiredKeys)
            && request.resource.data.keys().hasOnly(requiredKeys)
            && request.resource.data.responseId == responseId
            && request.resource.data.formId == formId
            && (
              currentForm.settings.access.allowMultiple == true
              || responseId == request.auth.uid
            )
            && validRespondentIdentity(currentForm)
            && request.resource.data.answers is map
            && request.resource.data.attachments is list
            && request.resource.data.status == 'submitted'
            && request.resource.data.formVersion is int
            && request.resource.data.submittedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.immutable is bool
            && getAfter(/databases/$(database)/documents/forms/$(formId)).data.responseCount
              == currentForm.responseCount + 1
            && getAfter(/databases/$(database)/documents/forms/$(formId)).data.latestResponseId
              == responseId
            && getAfter(/databases/$(database)/documents/forms/$(formId)).data.updatedAt
              == request.time;
        }

        // A response and the parent response counter must be written in the
        // same transaction. The parent rule verifies this document is new.
        allow create: if validResponseCreate();
        allow update: if false;
        // Respondents need to read only their own document so the client can
        // detect an existing submission before attempting an immutable create.
        allow get: if canManageForm(formId)
          || (signedIn() && (
            responseId == request.auth.uid
            || resource.data.respondentUid == request.auth.uid
            || resource.data.anonymousId == request.auth.uid
          ));
        allow list: if canManageForm(formId);
        allow delete: if canEditForm(formId);
      }

      match /drafts/{actorId} {
        allow read, delete: if canEditForm(formId) || (signedIn() && actorId == request.auth.uid);
        allow create, update: if signedIn() && actorId == request.auth.uid;
      }

      match /analysis/{analysisId} {
        allow read, create, update: if canManageForm(formId);
        allow delete: if canEditForm(formId);
      }

      match /versions/{versionId} {
        allow read: if canManageForm(formId);
        allow create: if canEditForm(formId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if canEditForm(formId);
      }

      match /quiz/{documentId} {
        allow read, write: if canEditForm(formId);
      }

      // OAuth refresh/access tokens are written and read only by Admin SDK
      // Cloud Functions. Form owners never receive these credentials.
      match /privateIntegrations/{documentId} {
        allow read, write: if false;
      }
    }

    match /formDrafts/{draftId} {
      allow create: if creatorSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow read, delete: if creatorSignedIn() && resource.data.creatorUid == request.auth.uid;
      allow update: if creatorSignedIn()
        && resource.data.creatorUid == request.auth.uid
        && request.resource.data.creatorUid == resource.data.creatorUid;
    }

    match /formSlugs/{slugId} {
      allow read, write: if false;
    }
  }
}
